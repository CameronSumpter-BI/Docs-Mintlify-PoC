{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Buzz Health Developer Portal",
  "colors": {
    "primary": "#00768D",
    "light": "#67C1D5",
    "dark": "#005D6F"
  },
  "background": {
    "color": { "light": "#FFFFFF", "dark": "#0A0A0A" }
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "https://www.buzzhealth.com"
  },
  "favicon": "/assets/favicon.svg",
  "fonts": {
    "heading": { "family": "Lato", "weight": 700 },
    "body": { "family": "Lato", "weight": 400 }
  },
  "icons": { "library": "fontawesome" },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "get-started/introduction", "get-started/quickstart", "get-started/getting-access"]
          },
          {
            "group": "Consumer API",
            "pages": [
              "consumer-api/authentication",
              "consumer-api/making-requests",
              "consumer-api/pricing-a-drug",
              "consumer-api/errors",
              "consumer-api/troubleshooting"
            ]
          },
          {
            "group": "Resources",
            "pages": ["resources/glossary", "resources/changelog"]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "openapi": {
          "source": "/api/consumer-api-v1.openapi.yaml",
          "directory": "api-reference"
        }
      }
    ]
  }
}
